# scripts/.env.deploy 템플릿.
#
#   cp scripts/.env.deploy.example scripts/.env.deploy
#
# 실제 값을 채운 scripts/.env.deploy 는 gitignored 다. 커밋하지 말 것 —
# 예전에 이 파일이 그대로 추적되고 있어서 DB 비밀번호와 배포 서버 계정이
# 저장소에 남았다.

# --- 배포 대상 ---
K3S_HOST=your-k3s-node.example.com
K3S_USER=your-ssh-user
NAMESPACE=timecapsule
KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# --- DB ---
DEPLOY_DB_PASSWORD=change-me

# --- 메일 ---
# 비워두면 in-cluster sink(mailpit)로 떨어진다. 개발/QA 는 그대로 두면 된다.
# 실제 발송으로 전환할 때만 아래를 채운다.
#DEPLOY_MAIL_HOST=smtp.example.com
#DEPLOY_MAIL_PORT=587
#DEPLOY_MAIL_USERNAME=
#DEPLOY_MAIL_PASSWORD=
#DEPLOY_MAIL_FROM=noreply@timecapsule.example.com
#DEPLOY_MAIL_SMTP_AUTH=true
#DEPLOY_MAIL_SMTP_STARTTLS_ENABLE=true
